[Unit]
Description=Podcast Downloader and Web UI
After=network.target

[Service]
Type=simple
User=user
WorkingDirectory=/disk/Pod/script
ExecStart=/home/user/.nvm/versions/node/v20.20.0/bin/node server.js
Restart=always
RestartSec=10
Environment=PORT=3456
Environment=STORAGE_ROOT=/disk/Pod
Environment=DB_PATH=/disk/Pod/script/podcasts.db

[Install]
WantedBy=multi-user.target
